---
// Logotipo de cada empresa del grupo, tal como lo publica (sobre blanco).
import logos from '../data/logos.json';
import type { Empresa } from '../data/empresas.ts';
interface Props {
  empresa: Empresa;
  class?: string;
}
const { empresa: e, class: cls = '' } = Astro.props;
const d = logos[e.logo] as { width: number; height: number; svg?: boolean };
const src = d.svg ? `/img/${e.logo}.svg` : `/img/${e.logo}.webp`;
---

<img class:list={['empresa-logo', `empresa-logo--${e.slug}`, cls]} src={src} width={d.width} height={d.height} alt={`Logotipo de ${e.nombre}`} loading="lazy" decoding="async" />
