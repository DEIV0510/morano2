  agreement: '<path d="M5 2.5h10l4 4V21.5H5z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M15 2.5v4h4M8 10h8M8 13.5h8M8 18c1.2-1.4 2.2-1.4 3 0s1.8 1.4 3 0" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  label: '<rect x="3.5" y="5" width="17" height="14" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="7" y="8.5" width="10" height="7" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 12h5" stroke="currentColor" stroke-width="1.5"/>',
