} as const;
const { name, class: cls = '', label, size = 24 } = Astro.props;
const vb = name === 'arrow' ? '0 0 15 10' : '0 0 24 24';
const w = name === 'arrow' ? 16 : size;
const h = name === 'arrow' ? 10 : size;
---

<svg
  class:list={['icon', `icon-${name}`, cls, { arrow: name === 'arrow' }]}
  viewBox={vb}
  width={w}
  height={h}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  set:html={ICONS[name]}
/>
