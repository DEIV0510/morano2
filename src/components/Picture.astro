---
// Fotografía real de Morano Gruppo en AVIF/WebP/JPEG con srcset. No recorta el
// archivo: el encuadre se resuelve con object-fit en CSS.
import images from '../data/images.json';

interface Props {
  name: keyof typeof images;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
}
const { name, alt, sizes, class: cls, loading = 'lazy', priority = false } = Astro.props;
const img = images[name];
// ?v= = huella del original: evita que un celular use una copia vieja de la caché.
const q = img.v ? `?v=${img.v}` : '';
const set = (ext: string) => img.widths.map((w) => `/img/${name}-${w}.${ext}${q} ${w}w`).join(', ');
const fallbackW = img.widths[img.widths.length - 1];
---

<picture class={cls}>
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={`/img/${name}-${fallbackW}.jpg${q}`}
    srcset={set('jpg')}
    sizes={sizes}
    width={img.width}
    height={img.height}
    alt={alt}
    loading={priority ? 'eager' : loading}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : undefined}
  />
</picture>
