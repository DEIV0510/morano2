---
// Pantalla de carga: la marca de Morano Gruppo aparece marco a marco (barrido
// diagonal), el nombre entra de izquierda a derecha y la cortina sube.
// Solo en la primera visita de la sesión; sale en cuanto la foto principal está
// lista (máx. ~1,8 s) y, sin JavaScript, sola.
import brand from '../data/brand.json';
const m = brand['gruppo-mark-reverse'];
const w = brand['gruppo-word-reverse'];
---

<div class="loader" data-loader role="status" aria-label="Cargando Morano Gruppo">
  <div class="loader__inner">
    <img class="loader__mark" src="/brand/gruppo-mark-reverse.png" width={m.width} height={m.height} alt="" />
    <img class="loader__word" src="/brand/gruppo-word-reverse.png" width={w.width} height={w.height} alt="" />
  </div>
  <div class="loader__bar" aria-hidden="true"><span></span></div>
</div>
