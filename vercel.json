      "destination": "/#empresas",
      "permanent": true
    },
    {
      "source": "/morano-gres",
      "destination": "/#empresas",
      "permanent": true
    },
    {
      "source": "/morano-gres/",
      "destination": "/#empresas",
      "permanent": true
    },
    {
